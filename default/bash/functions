# Compression
compress() { tar -czf "${1%/}.tar.gz" "${1%/}"; }
alias decompress="tar -xzf"

is_macos() {
  [[ "$(uname -s)" == "Darwin" ]]
}

list_external_disks() {
  if is_macos; then
    diskutil list external physical | awk '/^\/dev\/disk/ { print $1 }'
  else
    lsblk -d -o NAME | grep -E '^sd[a-z]' | awk '{print "/dev/"$1}'
  fi
}

# Write iso file to sd card
iso2sd() {
  if [ $# -ne 2 ]; then
    echo "Usage: iso2sd <input_file> <output_device>"
    if is_macos; then
      echo "Example: iso2sd ~/Downloads/ubuntu-25.04-live-server-amd64.iso /dev/disk4"
    else
      echo "Example: iso2sd ~/Downloads/ubuntu-25.04-desktop-amd64.iso /dev/sda"
    fi
    echo -e "\nAvailable removable disks:"
    list_external_disks
  else
    if is_macos; then
      disk="$2"
      raw_disk="${disk/\/dev\/disk/\/dev\/rdisk}"
      diskutil unmountDisk "$disk"
      sudo dd if="$1" of="$raw_disk" bs=4m conv=sync
      sync
      diskutil eject "$disk"
    else
      sudo dd bs=4M status=progress oflag=sync if="$1" of="$2"
      sudo eject "$2"
    fi
  fi
}

# Format an entire drive for a single partition using exFAT
format-drive() {
  if [ $# -ne 2 ]; then
    echo "Usage: format-drive <device> <name>"
    if is_macos; then
      echo "Example: format-drive /dev/disk4 'My Stuff'"
    else
      echo "Example: format-drive /dev/sda 'My Stuff'"
    fi
    echo -e "\nAvailable drives:"
    list_external_disks
  else
    echo "WARNING: This will completely erase all data on $1 and label it '$2'."
    read -rp "Are you sure you want to continue? (y/N): " confirm

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      if is_macos; then
        diskutil eraseDisk ExFAT "$2" GPT "$1"
      else
        sudo wipefs -a "$1"
        sudo dd if=/dev/zero of="$1" bs=1M count=100 status=progress
        sudo parted -s "$1" mklabel gpt
        sudo parted -s "$1" mkpart primary 1MiB 100%

        partition="$([[ $1 == *"nvme"* ]] && echo "${1}p1" || echo "${1}1")"
        sudo partprobe "$1" || true
        sudo udevadm settle || true

        sudo mkfs.exfat -n "$2" "$partition"
      fi

      echo "Drive $1 formatted as exFAT and labeled '$2'."
    fi
  fi
}

# Transcode a video to a good-balance 1080p that's great for sharing online
transcode-video-1080p() {
  ffmpeg -i $1 -vf scale=1920:1080 -c:v libx264 -preset fast -crf 23 -c:a copy ${1%.*}-1080p.mp4
}

# Transcode a video to a good-balance 4K that's great for sharing online
transcode-video-4K() {
  ffmpeg -i $1 -c:v libx265 -preset slow -crf 24 -c:a aac -b:a 192k ${1%.*}-optimized.mp4
}

# Transcode any image to JPG image that's great for shrinking wallpapers
img2jpg() {
  img="$1"
  shift

  magick "$img" $@ -quality 95 -strip ${img%.*}-converted.jpg
}

# Transcode any image to JPG image that's great for sharing online without being too big
img2jpg-small() {
  img="$1"
  shift

  magick "$img" $@ -resize 1080x\> -quality 95 -strip ${img%.*}-small.jpg
}

# Transcode any image to JPG image that's great for sharing online without being too big
img2jpg-medium() {
  img="$1"
  shift

  magick "$img" $@ -resize 1800x\> -quality 95 -strip ${img%.*}-medium.jpg
}

# Transcode any image to compressed-but-lossless PNG
img2png() {
  img="$1"
  shift

  magick "$img" $@ -strip -define png:compression-filter=5 \
    -define png:compression-level=9 \
    -define png:compression-strategy=1 \
    -define png:exclude-chunk=all \
    "${img%.*}-optimized.png"
}

# SSH Port Forwarding Functions
fip() {
  [[ $# -lt 2 ]] && echo "Usage: fip <host> <port1> [port2] ..." && return 1
  local host="$1"
  shift
  for port in "$@"; do
    ssh -f -N -L "$port:localhost:$port" "$host" && echo "Forwarding localhost:$port -> $host:$port"
  done
}

dip() {
  [[ $# -eq 0 ]] && echo "Usage: dip <port1> [port2] ..." && return 1
  for port in "$@"; do
    pkill -f "ssh.*-L $port:localhost:$port" && echo "Stopped forwarding port $port" || echo "No forwarding on port $port"
  done
}

lip() {
  pgrep -af "ssh.*-L [0-9]+:localhost:[0-9]+" || echo "No active forwards"
}
